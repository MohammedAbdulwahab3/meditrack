# Copy to .env and fill in. Never commit .env.

# Database password (any long random string)
DB_PASSWORD=change-me-to-a-long-random-string

# 32+ random characters, e.g. `openssl rand -base64 48`
SECRET_KEY=change-me-to-at-least-32-random-characters

# First administrator account (created on first start if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Public hostname. With a real domain, Caddy fetches HTTPS certificates automatically.
# For a local machine, keep ":80" and set COOKIE_SECURE=false (no HTTPS on localhost:80).
SITE_ADDRESS=:80
PUBLIC_URL=
COOKIE_SECURE=false
HTTP_PORT=80
HTTPS_PORT=443
